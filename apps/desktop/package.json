{
  "name": "@cockpit/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Cockpit desktop app",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "test": "bun run package && vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@cockpit/harnesses": "workspace:*",
    "@cockpit/pty": "workspace:*",
    "@cockpit/shell-env": "workspace:*",
    "@cockpit/state": "workspace:*",
    "@cockpit/workspaces": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
